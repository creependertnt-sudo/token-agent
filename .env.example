# DeepSeek / OpenAI-compatible API（必填，勿提交真实 Key）
OPENAI_API_KEY=

# 可选：前端 API 基址（本地开发通常留空）
NEXT_PUBLIC_API_URL=

# 会话 Cookie 签名（生产环境请使用长随机字符串）
SESSION_SECRET=

# 火山引擎语音 STT / TTS（勿提交真实 Key；代码读取 VOLC_API_KEY）
VOLC_APP_ID=
VOLC_API_KEY=

# 可选：流式 Markdown 安全（默认开启）
# NEXT_PUBLIC_ENABLE_STREAM_ESCAPE=true
