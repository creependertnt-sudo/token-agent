# DeepSeek / OpenAI-compatible API (required for chat LLM)
OPENAI_API_KEY=your_api_key_here

# Optional: override API base URL / model name used by some tooling
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# Optional: model-router overrides (defaults match DeepSeek chat)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# Session cookie signing (set a long random string in production)
SESSION_SECRET=your_session_secret_here

# Optional: integration test base URL
# TEST_BASE_URL=http://localhost:3000

# 火山引擎豆包语音（STT / TTS）— 填入 .env.local，勿提交真实 Key
VOLC_API_KEY=
VOLC_APP_ID=
VOLC_STT_RESOURCE_ID=volc.seedasr.auc
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
# VOLC_TTS_SPEAKER=zh_female_vv_uranus_bigtts

# 流式 Markdown 安全：流式阶段 escape，结束时一次性 unescape（默认开启；设 false 可回滚）
NEXT_PUBLIC_ENABLE_STREAM_ESCAPE=true
