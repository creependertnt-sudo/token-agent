// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum OrderStatus {
  PENDING
  SUCCESS
  FAILED
}

enum MessageRole {
  user
  assistant
  system
  tool
}

enum MemoryCategory {
  preference
  business
  product
  fact
}

enum AIServiceType {
  SALES
  LIGHT
  STANDARD
  PREMIUM
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  /** 聊天显示名；未设置时为「未设置昵称」 */
  nickname      String?
  /** 头像标识（首字母/预设 key）；可空，前端回退昵称首字 */
  avatar        String?
  tokenBalance  Int      @default(0)
  freeChatCount Int      @default(20)
  createdAt     DateTime @default(now())

  orders            Order[]
  conversations     Conversation[]
  memories          AgentMemory[]
  selectedServices  UserSelectedService[]
  tokenUsages       TokenUsage[]

  @@index([createdAt])
}

model AgentMemory {
  id        String         @id @default(cuid())
  userId    String
  category  MemoryCategory
  content   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, category])
  @@index([userId, updatedAt])
}

model AIProvider {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  website     String?
  description String?
  createdAt   DateTime @default(now())

  models AIModel[]

  @@index([createdAt])
}

model AIModel {
  id            String   @id @default(cuid())
  providerId    String
  name          String
  slug          String   @unique
  description   String?
  contextWindow Int?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  provider AIProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  services AIService[]

  @@index([providerId])
  @@index([active])
  @@index([createdAt])
}

model AIService {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  type        AIServiceType
  tokenCost   Int
  /** SALES 可为 null；LIGHT/STANDARD/PREMIUM 绑定实际调用的模型 */
  modelId     String?
  active      Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())

  model         AIModel?              @relation(fields: [modelId], references: [id], onDelete: SetNull)
  selections    UserSelectedService[]
  usages        TokenUsage[]
  conversations Conversation[]

  @@index([type])
  @@index([modelId])
  @@index([active, sortOrder])
  @@index([createdAt])
}

model UserSelectedService {
  id        String   @id @default(cuid())
  userId    String
  serviceId String
  createdAt DateTime @default(now())

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  service AIService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([serviceId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model TokenUsage {
  id        String   @id @default(cuid())
  userId    String
  serviceId String
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  service AIService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([serviceId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model TokenPackage {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  tokenAmount Int
  price       Float
  description String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  orders Order[]

  @@index([active, sortOrder])
  @@index([createdAt])
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  packageId   String
  tokenAmount Int
  amount      Float
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  package TokenPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([packageId])
  @@index([status])
  @@index([createdAt])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  /** 当前会话选用的 AI 服务（可切换，不影响登录） */
  serviceId String?
  createdAt DateTime @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  service  AIService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([userId])
  @@index([serviceId])
  @@index([userId, createdAt])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  /** 生成该条助手消息时锁定的档位；user 消息可为空 */
  serviceType    String?
  /** 展示名，如 C模型AI */
  modelName      String?
  /** 本条实际扣费 */
  tokenCost      Int?
  /** 本条扣费后的余额快照（历史展示用，禁止用当前余额覆盖） */
  tokenBalanceAfter Int?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

/** SALES 销售知识库（RAG 检索） */
model SalesKnowledge {
  id        String   @id @default(cuid())
  /** product | pricing | model_diff | competitor | faq | script */
  category  String
  title     String
  content   String
  /** 逗号或空格分隔的检索关键词 */
  keywords  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([updatedAt])
}

/** A/B/C 模型能力说明（SALES 推荐用） */
model ModelCapability {
  id             String   @id @default(cuid())
  /** LIGHT | STANDARD | PREMIUM */
  serviceType    String   @unique
  /** 展示名，如 A模型AI */
  name           String
  tokenCost      Int
  /** 定位一句话 */
  positioning    String
  /** 适合场景（多行/分号分隔） */
  suitableFor    String
  /** 不太适合的场景 */
  notSuitableFor String
  /** 典型客户画像 */
  persona        String
  keywords       String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sortOrder])
}

/** 竞品知识库 */
model CompetitorKnowledge {
  id          String   @id @default(cuid())
  /** Coze | Dify | FastGPT | Chatbase */
  name        String
  slug        String   @unique
  summary     String
  strengths   String
  /** 相对 Token AI 的差异（不攻击） */
  differences String
  talkTrack   String
  keywords    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

/**
 * A/B/C 模型配置（权威来源：prompt / 比较 / 销售推荐）
 * LIGHT=A / STANDARD=B / PREMIUM=C
 * 禁止在代码里写死能力介绍与适用场景，一律读本表 + ModelCapability。
 */
model ModelConfig {
  id                  String   @id @default(cuid())
  /** LIGHT | STANDARD | PREMIUM */
  serviceType         String   @unique
  /** A | B | C */
  grade               String
  /** 展示名，如 A模型AI */
  name                String
  /** 能力描述 */
  capability          String
  /** 适用场景 */
  suitableFor         String
  /** 限制 / 不适合 */
  limitations         String
  /** 每次 Token 价格 */
  tokenCost           Int
  /** 最大上下文（token 数，展示用） */
  maxContext          Int
  /** 注入该档 system prompt 的行为说明（来自 DB，禁止代码写死档位定位） */
  systemInstructions  String   @default("")
  keywords            String
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([grade])
  @@index([sortOrder])
}

/** 销售策略（按意图 / 客户类型注入话术与执行准则） */
model SalesStrategy {
  id           String   @id @default(cuid())
  /** 业务编码，如 model_select_default */
  code         String   @unique
  /** PRICE_QUERY | MODEL_SELECT | … | * */
  intent       String
  /** STUDENT | INDIVIDUAL_DEV | … | * */
  customerType String   @default("*")
  name         String
  guidelines   String
  talkTrack    String
  forbidden    String   @default("")
  priority     Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([intent])
  @@index([priority])
}

/** 客户画像模板（匹配关键词 → 画像与默认问诊） */
model CustomerProfile {
  id                   String   @id @default(cuid())
  /** STUDENT | INDIVIDUAL_DEV | STARTUP_TEAM | ENTERPRISE | UNKNOWN */
  code                 String   @unique
  name                 String
  description          String
  matchKeywords        String
  typicalNeeds         String
  talkTrack            String
  /** LIGHT | STANDARD | PREMIUM | 空=无默认 */
  defaultRecommend     String   @default("")
  clarifyingQuestions  String
  sortOrder            Int      @default(0)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([sortOrder])
}

/** 模型推荐规则（需求/预算/行业/技术 → LIGHT/STANDARD/PREMIUM） */
model ModelRecommendRule {
  id                    String   @id @default(cuid())
  name                  String
  priority              Int      @default(0)
  /** STUDENT|…|* */
  customerType          String   @default("*")
  /** PRICE_QUERY|…|* */
  intent                String   @default("*")
  /** low|medium|high|* */
  budgetLevel           String   @default("*")
  /** beginner|intermediate|expert|* */
  techLevel             String   @default("*")
  /** 消息命中任一关键词即加分；逗号分隔 */
  matchKeywords         String   @default("")
  /** 必须全部命中（可空） */
  requireKeywords       String   @default("")
  /** 命中则跳过本规则 */
  excludeKeywords       String   @default("")
  /** LIGHT | STANDARD | PREMIUM */
  recommendServiceType  String
  reasonTemplate        String
  /** low | medium | high */
  confidence            String   @default("medium")
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([priority])
  @@index([active])
}
